# Database (Local Docker: postgresql://... / Deployed: Neon postgresql://...?sslmode=require)
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgres://postgres:changeme@localhost:5432/interview_platform?sslmode=disable

# Cache (Local Docker: redis://localhost:6379 / Deployed: Upstash rediss://...)
REDIS_URL=redis://localhost:6379

# Event Broker: Outbox pattern is used for all environments (local and production).
# Leave KAFKA_BROKERS empty to use Postgres outbox tables (outbox_turns, outbox_completed).
KAFKA_BROKERS=

# Service URLs & Networking
JOB_CANDIDATE_SERVICE_URL=http://localhost:8001
PLATFORM_SERVICE_URL=http://localhost:8001
APP_DOMAIN=http://localhost:3000

# Auth
JWT_SECRET=your-secret-key-min-32-chars-change-this
INTERNAL_API_KEY=internal-secret-key-change-this

# LLM Provider (Groq - fast streaming inference)
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
EVALUATION_LLM_MODE=groq  # 'groq' for live evaluation, or 'mock' for local offline testing
FEEDBACK_LLM_MODE=groq

# Speech-to-Text (Deepgram)
DEEPGRAM_API_KEY=...

# Text-to-Speech (ElevenLabs)
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # Rachel voice (default)

# Voice Pipeline Diagnostics & Observability
# Enables GET /debug/voice endpoint in interview-orchestrator and ?debug=1 telemetry HUD in browser
VOICE_DEBUG=true

# Demo Mode
# Set to 'false' to enable live voice streaming (Deepgram STT, Groq LLM, ElevenLabs TTS).
# Set to 'true' to run offline demo mode using prompts without third-party API keys.
ASSESSMENT_DEMO_MODE=false
INTERVIEW_DEMO_MODE=false

# Object storage (MinIO locally / Cloudflare R2 / AWS S3 when deployed)
# For Local MinIO:
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_AUDIO=assessment-audio
MINIO_USE_SSL=false

# For Cloudflare R2 (use your R2 S3 API credentials):
# MINIO_ENDPOINT=<ACCOUNT_ID>.r2.cloudflarestorage.com
# MINIO_ROOT_USER=<R2_ACCESS_KEY_ID>
# MINIO_ROOT_PASSWORD=<R2_SECRET_ACCESS_KEY>
# MINIO_BUCKET_AUDIO=assessment-audio
# MINIO_USE_SSL=true


# Embeddings (Gemini or OpenAI)
# For Google Gemini free embedding:
#   EMBEDDING_API_KEY=AIzaSy...
#   EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   EMBEDDING_MODEL=gemini-embedding-001
#   EMBEDDING_DIMS=768
# For OpenAI:
#   EMBEDDING_API_KEY=sk-...
#   EMBEDDING_MODEL=text-embedding-3-small
#   EMBEDDING_DIMS=768
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=768
