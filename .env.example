# Database (Local Docker: postgresql://... / Deployed: Neon postgresql://...?sslmode=require)
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgres://postgres:changeme@localhost:5432/interview_platform?sslmode=disable

# Cache (Local Docker: redis://localhost:6379 / Deployed: Upstash rediss://...)
REDIS_URL=redis://localhost:6379

# Event Broker (Leave KAFKA_BROKERS empty for Postgres outbox mode on Railway)
KAFKA_BROKERS=localhost:9092

# Service URLs & Networking
JOB_CANDIDATE_SERVICE_URL=http://localhost:8001
PLATFORM_SERVICE_URL=http://localhost:8001
APP_DOMAIN=http://localhost:8080

# Auth
JWT_SECRET=your-secret-key-min-32-chars-change-this
INTERNAL_API_KEY=internal-secret-key-change-this

# LLM Provider (Groq - fast streaming inference)
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
EVALUATION_LLM_MODE=groq  # 'groq' for live evaluation, or 'mock' for local offline testing
FEEDBACK_LLM_MODE=groq

# Speech-to-Text (Deepgram)
DEEPGRAM_API_KEY=...

# Text-to-Speech (ElevenLabs)
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # Rachel voice (default)

# Demo Mode
# Set to 'false' to enable live voice streaming (Deepgram STT, Groq LLM, ElevenLabs TTS).
# Set to 'true' to run offline demo mode using prompts without third-party API keys.
ASSESSMENT_DEMO_MODE=false
INTERVIEW_DEMO_MODE=false

# Object storage (MinIO locally / Cloudflare R2 when deployed)
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_AUDIO=assessment-audio
MINIO_USE_SSL=false

# Embeddings (OpenAI / text-embedding-3-small)
OPENAI_EMBEDDING_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=768

